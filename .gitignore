# =============================================================================
# Mini KiotViet - Git Ignore Configuration
# =============================================================================

# 1. Dependencies & Package Managers
node_modules/
vendor/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 2. Local Environment & Secret Keys
.env
.env.*
!.env.example
*.key
*.pem
*.cert
*.crt

# 3. Runtime, Debug & Error Logs
*.log
mkv_request.log
debug.log
error_log

# 4. Scratch, Temporary & Diagnostic Scripts
scratch/
*.tmp
*.temp

# 5. Database Dumps & Local Backups
*.sql
*.sqlite
*.sqlite3
*.dump
*.bak
*.backup

# 6. Archives & Distribution Packages
*.zip
*.tar.gz
*.rar
*.7z

# 7. IDE, Code Editors & Workspaces
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# 8. Operating System Generated Files
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
